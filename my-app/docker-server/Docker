FROM nginx:alpine

# 1. Disable Gzip (Compression ruins speed test accuracy)
RUN sed -i 's/gzip  on;/gzip off;/' /etc/nginx/nginx.conf

# 2. Add CORS headers so your Next.js app can fetch data from here
RUN echo 'server { \
    listen 80; \
    location / { \
        add_header "Access-Control-Allow-Origin" "*"; \
        root /usr/share/nginx/html; \
    } \
}' > /etc/nginx/conf.d/default.conf

# 3. Create a 50MB dummy file for the test
RUN dd if=/dev/urandom of=/usr/share/nginx/html/test.bin bs=1M count=50

EXPOSE 80